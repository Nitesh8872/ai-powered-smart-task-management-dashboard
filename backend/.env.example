NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/student-dashboard
JWT_SECRET=replace-with-a-long-random-secret
REFRESH_SECRET=replace-with-a-different-long-random-secret
# No trailing slashes. Production default also trusts all *.vercel.app deploy URLs.
CORS_ORIGIN=*.vercel.app,*.github.io,http://localhost:5500,http://127.0.0.1:5500
RATE_LIMIT_MAX=100
